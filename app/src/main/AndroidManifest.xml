<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draw the dimmer overlay above every app. Granted in Settings, not at install. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Global remote-key interception. Granted by enabling the service in Accessibility settings. -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        TV power link. HDMI_CEC is signature|privileged, so a sideloaded app is
        never actually granted it: TvPowerLink calls the CEC API reflectively
        and falls back to a brief HDMI activity. Declared so the intent is
        visible (and so the app can use CEC if it is ever installed privileged).
    -->
    <uses-permission android:name="android.permission.HDMI_CEC" />

    <!-- Android TV: a touchscreen is not required; Leanback launcher is the target. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/LeoDimmerGuidedStep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            TV power link helper: invisible, non-interactive, finishes itself.
            Launched only when HDMI-CEC one-touch-play is unavailable, to make
            the box drive HDMI output and wake a CEC-enabled TV.
        -->
        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
            Headless ADB control. Exported on purpose: `adb shell am startservice`
            runs outside the app, so a non-exported service would reject it.
            This is a local-device control surface for the owner's own box, not
            a network service: it only changes this app's overlay opacity.
        -->
        <service
            android:name=".DimmerService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-controlled screen dimming overlay for Android TV" />
        </service>

        <!--
            Global key interception. The BIND_ACCESSIBILITY_SERVICE permission
            is signature-level: only the system can bind to it, even though the
            service is exported (the system binding requires this permission).
        -->
        <service
            android:name=".DimmerAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/dimmer_accessibility_config" />
        </service>

        <!-- Persistent lifecycle: restart the overlay after a reboot, but only
             if the user had previously started it (service_enabled in prefs).
             Also the "box powered on" trigger for the TV power link. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
