<?xml version="1.0" encoding="utf-8"?>
<!-- The overlay itself: one full-screen black view. Inflated ONCE by
     DimmerService; brightness steps only change this view's alpha in memory.
     Never re-inflate this layout for a brightness change. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/overlay_dim_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000" />

</FrameLayout>
