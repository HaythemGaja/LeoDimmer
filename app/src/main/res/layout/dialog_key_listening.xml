<?xml version="1.0" encoding="utf-8"?>
<!-- High-contrast, dark-room layout: white text on near-black, yellow accent
     (#FFD166) for the waiting indicator and the cancel hint. Centered, with
     generous padding so it reads from the sofa on a TV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="48dp"
    android:background="#FF111111">

    <TextView
        android:id="@+id/txt_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Listening for a remote button…"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <ProgressBar
        android:id="@+id/progress_listening"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="32dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFD166" />

    <TextView
        android:id="@+id/txt_dialog_cancel_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Press BACK to cancel"
        android:textColor="#FFD166"
        android:textSize="18sp" />

</LinearLayout>
